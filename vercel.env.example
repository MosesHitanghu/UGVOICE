# Add these in Vercel Project Settings > Environment Variables.
# DATABASE_URL is preferred. Common Neon/Vercel POSTGRES_* alternatives are
# discovered automatically when an integration supplies them instead.
DATABASE_URL=postgresql://user:password@pooled-host/database?sslmode=require
UGVOICE_CREATE_DATABASE=false
UGVOICE_RUN_STARTUP_SCHEMA_SYNC=false

# Hugging Face remote inference. Never expose this token to Vite/frontend variables.
UGVOICE_ML_PROVIDER=huggingface
HF_TOKEN=hf_replace_me
HF_INFERENCE_TIMEOUT_SECONDS=25
HF_INFERENCE_MAX_ATTEMPTS=2
HF_ENABLE_EMBEDDINGS=true
HF_SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
HF_SUMMARY_MODEL=facebook/bart-large-cnn
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# DigitalOcean Spaces. The existing storage adapter also works from Vercel.
UGVOICE_STORAGE_BACKEND=spaces
SPACES_REGION=fra1
SPACES_BUCKET=your-ugvoice-space
SPACES_KEY=replace_me
SPACES_SECRET=replace_me
SPACES_CDN_ENDPOINT=https://your-ugvoice-space.fra1.cdn.digitaloceanspaces.com
SPACES_PUBLIC_FILES=true

UGVOICE_DB_SETUP_TOKEN=replace_with_a_long_random_secret

# Used by the protected production seed operation to promote/create the administrator.
UGVOICE_ADMIN_EMAIL=hmosesm@gmail.com
UGVOICE_ADMIN_USERNAME=moshe
UGVOICE_ADMIN_FIRST_NAME=Moshe
UGVOICE_ADMIN_PASSWORD=replace_with_a_strong_password
