# Database
DATABASE_URL=postgresql://user:password@host:25060/database?sslmode=require
# The backend also recognizes Vercel/Neon POSTGRES_URL, DATABASE_URL_UNPOOLED,
# POSTGRES_URL_NON_POOLING, POSTGRES_PRISMA_URL, and component variables.
UGVOICE_CREATE_DATABASE=false
UGVOICE_RUN_STARTUP_SCHEMA_SYNC=false
DB_CONNECT_TIMEOUT_SECONDS=10

# Browser access. Same-origin /api deployments do not require a production URL here.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# DigitalOcean Spaces (required for persistent uploads in production)
UGVOICE_STORAGE_BACKEND=spaces
SPACES_REGION=fra1
SPACES_BUCKET=your-ugvoice-space
SPACES_KEY=replace-me
SPACES_SECRET=replace-me
SPACES_CDN_ENDPOINT=https://your-ugvoice-space.fra1.cdn.digitaloceanspaces.com
SPACES_PUBLIC_FILES=true
MAX_THUMBNAIL_BYTES=5242880
MAX_ATTACHMENT_BYTES=20971520

# Use `huggingface` for remote inference, `local` with requirements-ml.txt, or
# `disabled` for labelled lightweight fallbacks only.
UGVOICE_ML_PROVIDER=huggingface
UGVOICE_ML_ENABLED=false
HF_TOKEN=
HF_INFERENCE_TIMEOUT_SECONDS=25
HF_INFERENCE_MAX_ATTEMPTS=2
HF_ENABLE_EMBEDDINGS=true

# Protect database administration endpoints.
UGVOICE_DB_SETUP_TOKEN=replace-with-a-long-random-secret

# Primary administrator promoted (or created) by seed_dummy_data.py.
UGVOICE_ADMIN_EMAIL=hmosesm@gmail.com
UGVOICE_ADMIN_USERNAME=moshe
UGVOICE_ADMIN_FIRST_NAME=Moshe
UGVOICE_ADMIN_PASSWORD=
